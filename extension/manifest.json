{
  "manifest_version": 3,
  "name": "Hide My Text",
  "version": "2.0.0",
  "icons": {
    "16": "images/hide-my-text-16.png",
    "32": "images/hide-my-text-32.png",
    "48": "images/hide-my-text-48.png",
    "128": "images/hide-my-text-128.png"
  },
  "description": "Hide your username, IP address and more. Hides (deletes, replaces or blurs) texts you choose on websites you choose. Great for Screen sharing on calls for professionals, streamers and content creators.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Hide My Text",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/hide-my-text-16.png",
      "32": "images/hide-my-text-32.png",
      "48": "images/hide-my-text-48.png",
      "128": "images/hide-my-text-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
